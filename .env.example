NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql:///parc_ledger
# Inbound: Auth-issued tokens for the parc-ledger audience, verified via JWKS.
AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUTH_JWT_ISSUER=https://auth.parc.invalid
# Outbound (Tenant Admin approvals): this service's ES256 key, registered
# (public half) in Auth & Customer SERVICE_CLIENT_KEYS_JSON under "parc-ledger".
AUTH_TOKEN_URL=http://127.0.0.1:3001/internal/v1/oauth/token
SERVICE_CLIENT_KEY_ID=parc-ledger-1
SERVICE_CLIENT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-es256-private-key
TENANT_ADMIN_URL=http://127.0.0.1:3002
AMQP_URL=amqp://guest:guest@127.0.0.1:5672
LEDGER_INBOUND_ROUTING_KEYS=tenant.configuration-changed.v1
LEDGER_INTEGRITY_TENANT_IDS=
LEDGER_INTEGRITY_INTERVAL_MS=86400000
